# Sao chép thành .env (đã có trong .gitignore) rồi điền giá trị. Giải thích từng biến: xem phần chú thích trong .env.
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=

