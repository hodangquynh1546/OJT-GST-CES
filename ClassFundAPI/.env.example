# Sao chép thành .env (đã có trong .gitignore) hoặc dùng `dotnet user-secrets`. KHÔNG commit giá trị thật.
# Database dùng chung: Neon PostgreSQL (docs/implementation/neon-database-guide.md).

# Tài khoản app_user: Backend dùng khi chạy (chỉ SELECT/INSERT/UPDATE).
ConnectionStrings__App="Host=<neon-host>;Database=<db>;Username=app_user;Password=<password>;SSL Mode=Require;Trust Server Certificate=false"

# Tài khoản migrator_user: CHỈ dùng khi chạy `dotnet ef database update` (một người được phân công).
ConnectionStrings__Migrator="Host=<neon-host>;Database=<db>;Username=migrator_user;Password=<password>;SSL Mode=Require"

ASPNETCORE_ENVIRONMENT=Development
RateLimiting__AuthPermitLimit=

# Bắt buộc, >= 32 ký tự (pepper băm mật khẩu): openssl rand -base64 48
SECRET_KEY=

# Lưu file thực tế: Neon Object Storage (S3-compatible). Local chỉ cho test / dev offline (mặc định tới khi xong M5-T0).
Storage__Provider=Local
Storage__LocalRoot=
Storage__Endpoint=
Storage__Bucket=classfund-files
Storage__Region=
Storage__AccessKeyId=
Storage__SecretAccessKey=
